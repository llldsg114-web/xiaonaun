# 心屿心智引擎运行配置（复制为 .env 后按需修改）

# MCP / HTTP 服务端口
PORT=3000

# MCP 端点路径（Streamable HTTP）
MCP_ENDPOINT=/mcp

# 本地 JSONL 存储目录
STORAGE_DIR=./.data

# OAuth 2.1 Bearer 令牌自签发密钥。
# ⚠️ 生产环境（NODE_ENV=production）【必须】显式配置强随机值，否则服务启动即抛错：
#     Error: JWT_SECRET 必须在生产环境显式配置
# 漏配会导致使用公开硬编码弱密钥，任何人可伪造令牌绕过 Bridge 边界与读写控制。
# 本地开发可留空（会回退到默认弱密钥并告警，仅限非生产使用）。
JWT_SECRET=change-me-in-production
TOKEN_ISSUER=xinyu-mind-engine

# 状态机默认参数（均可覆盖）
# 维度基线（无刺激时回归值），范围 [0,1]
BASELINE=0.20
# 衰减半衰期（轮数）：值越大衰减越慢
HALF_LIFE_ROUNDS=8
# 单事件单维度最大增量（防越界），范围 (0,1]
MAX_DELTA_PER_EVENT=0.15
